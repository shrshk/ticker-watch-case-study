# ---------------------------------------------------------------------------
# Copy to .env and fill in ALBERT_API_KEY (from the case study email).
# ---------------------------------------------------------------------------

# Vendor API ----------------------------------------------------------------
ALBERT_API_KEY=replace-me
ALBERT_API_BASE=https://app.albert.com/casestudy

# Datastores ----------------------------------------------------------------
POSTGRES_DSN=postgresql://postgres:postgres@db:5432/postgres
REDIS_URL=redis://redis:6379/0

# Auth ----------------------------------------------------------------------
# Also signs Centrifugo connection tokens in phase 3.
JWT_SECRET=dev-only-not-a-secret
JWT_TTL_SECONDS=86400

# Price service -------------------------------------------------------------
# api = real vendor. simulated = random walk from seeded prices (offline/bench).
PRICE_SOURCE=api

# Clients are updated every PUBLISH_INTERVAL_SECONDS. The vendor is called
# every UPSTREAM_POLL_INTERVAL_SECONDS. Decoupling them is what lets the
# product promise 5s while spending less at a per-call-priced vendor.
PUBLISH_INTERVAL_SECONDS=5
UPSTREAM_POLL_INTERVAL_SECONDS=5

# Must exceed the worst expected gap between updates for any ticker, or quiet
# tickers expire between ticks and every read for them falls through.
PRICE_CACHE_TTL_SECONDS=60

# Simulated source ----------------------------------------------------------
SIM_VOLATILITY=0.002
SIM_CHANGE_RATIO=0.30
SIM_SEED=1

# Read path -----------------------------------------------------------------
# redis = read-through cache. postgres = bypass the cache entirely.
LATEST_PRICE_SOURCE=redis

# Client --------------------------------------------------------------------
TRANSPORT=poll
VITE_API_BASE_URL=http://localhost:8000

# Host ports for the datastores. Defaults avoid clashing with a local
# Postgres or Redis already bound to the standard ports.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# Uvicorn arguments. Empty means --reload, which is a single process and is
# what you want for development. Benchmarks set "--workers N".
#
# Set this HERE, not inline on the command line: `docker compose run` recreates
# depends_on services from the ambient environment, so an inline override is
# silently dropped the next time any other compose command runs, and the
# benchmark then measures a one-worker dev server without saying so.
UVICORN_ARGS=

# Postgres connections are a shared budget. The pool is PER PROCESS, so the
# server-wide total is (uvicorn workers x DB_POOL_MAX_SIZE) + the price
# service's pool, and it must stay under Postgres max_connections (200 here).
# 8 workers x 16 = 128, which fits; at the stock 100 it would not.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=16
